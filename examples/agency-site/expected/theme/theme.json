{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#1f5f4b"
        },
        {
          "slug": "dark",
          "name": "Dark",
          "color": "#12261f"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "neutral",
          "name": "Neutral",
          "color": "#f4f4f1"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1b1b1b"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5c625f"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "h3",
          "name": "Heading 3",
          "size": "1.375rem",
          "fluid": false
        },
        {
          "slug": "h2",
          "name": "Heading 2",
          "size": "1.875rem",
          "fluid": false
        },
        {
          "slug": "h1",
          "name": "Heading 1",
          "size": "2.5rem",
          "fluid": false
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "clamp(2.5rem, 1.8rem + 3vw, 4rem)",
          "fluid": true
        }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "1 / 8px",
          "size": "8px"
        },
        {
          "slug": "20",
          "name": "2 / 16px",
          "size": "16px"
        },
        {
          "slug": "30",
          "name": "3 / 24px",
          "size": "24px"
        },
        {
          "slug": "40",
          "name": "4 / 40px",
          "size": "40px"
        },
        {
          "slug": "50",
          "name": "5 / 64px",
          "size": "64px"
        },
        {
          "slug": "60",
          "name": "6 / 96px",
          "size": "96px"
        }
      ]
    },
    "custom": {
      "card": {
        "background": "var(--wp--preset--color--surface)",
        "radius": "8px",
        "padding": {
          "top": "30px",
          "right": "30px",
          "bottom": "30px",
          "left": "30px"
        },
        "shadow": "0 1px 2px rgba(0, 0, 0, 0.06), 0 4px 12px rgba(0, 0, 0, 0.04)",
        "borderColor": "var(--wp--preset--color--neutral)"
      },
      "lineHeight": {
        "small": "1.5",
        "body": "1.6",
        "h3": "1.3",
        "h2": "1.25",
        "h1": "1.15",
        "display": "1.1"
      },
      "sectionRhythm": {
        "default": "var(--wp--preset--spacing--50)",
        "tight": "var(--wp--preset--spacing--40)",
        "loose": "var(--wp--preset--spacing--60)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|surface",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "var(--wp--custom--line-height--body)"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "left": "24px",
        "right": "24px"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|h-1",
          "lineHeight": "var(--wp--custom--line-height--h-1)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|h-2",
          "lineHeight": "var(--wp--custom--line-height--h-2)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|h-3",
          "lineHeight": "var(--wp--custom--line-height--h-3)"
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|surface"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "right": "28px",
            "bottom": "14px",
            "left": "28px"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|body"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|dark",
            "text": "var:preset|color|surface"
          }
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|dark"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
